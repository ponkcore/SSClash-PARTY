#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

SERVICE=/usr/libexec/ssclash-profile-sync

start_service() {
	local enabled
	enabled="$(uci -q get ssclash_profile.main.enabled)"
	[ "$enabled" = "1" ] || return 0
	[ -x "$SERVICE" ] || return 1

	procd_open_instance
	procd_set_param command "$SERVICE" daemon
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger ssclash_profile
}
