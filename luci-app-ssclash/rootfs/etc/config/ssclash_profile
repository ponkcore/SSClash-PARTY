config globals 'main'
	option source_mode 'subscription'
	option active_profile 'default'
	option rules_mode 'template'
	option template_id 'russia'
	option lan_interface 'lan'
	option health_url_primary 'https://www.gstatic.com/generate_204'
	option health_url_secondary 'https://cp.cloudflare.com/generate_204'

config subscription 'default'
	option name 'Default'
	option enabled '0'
	option url ''
	option rules_mode 'auto'
	option template_id 'russia'
	option interval '3600'
	option user_agent 'auto'
	option hwid ''
	option device_os 'OpenWrt'
	option device_model ''

config router 'router'
	option dns_mode 'redir-host'
	option dns_listen '127.0.0.1:7874'
	option fake_ip_range '198.18.0.1/16'
	option fake_ip_filter_mode 'blacklist'
	option store_fake_ip '1'
	list fake_ip_filter '*.lan'
	list fake_ip_filter '*.local'
	list fake_ip_filter 'panel.router'
	option proxy_mode 'tproxy'
	option tproxy_port '7894'
	option routing_mark '2'
	option tun_stack 'system'
	option ipv6_enabled '0'
	option controller_mode 'auto'
	option controller_host ''
	option controller_port '9090'
	option controller_secret ''
	option panel_enabled '1'
	option panel_hostname 'panel.router'
