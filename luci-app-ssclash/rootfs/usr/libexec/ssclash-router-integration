#!/bin/sh

set -u
LC_ALL=C
export LC_ALL

PROFILE_CONFIG=${SSCLASH_PROFILE_CONFIG:-/etc/config/ssclash_profile}
PROFILE_SYNC=${SSCLASH_PROFILE_SYNC:-/usr/libexec/ssclash-profile-sync}
PANEL_HELPER=${SSCLASH_PANEL_HELPER:-/usr/libexec/ssclash-party-panel}
PENDING_SECTION=pending
ROUTER_SECTION=router

json_result() {
	printf '{"ok":%s,"code":"%s","message":"%s","blockers":%s,"warnings":%s,"corrections":%s}\n' \
		"$1" "$2" "$3" "${4:-0}" "${5:-0}" "${6:-0}"
}

value() {
	local section="$1"
	local option="$2"
	local fallback="${3:-}"
	local result
	result="$(uci -q get "ssclash_profile.$section.$option" 2>/dev/null)"
	[ -n "$result" ] && printf '%s\n' "$result" || printf '%s\n' "$fallback"
}

valid_port() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1024 ] && [ "$1" -le 65535 ]
}

valid_dns_listener() {
	local listener="$1"
	local address port
	case "$listener" in
		127.*:*) ;;
		*) return 1 ;;
	esac
	address=${listener%:*}
	port=${listener##*:}
	valid_private_ipv4 "$address" || return 1
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ]
}

valid_private_ipv4() {
	local address="$1"
	local first second third fourth octet
	IFS=. read -r first second third fourth <<EOF
$address
EOF
	for octet in "$first" "$second" "$third" "$fourth"; do
		case "$octet" in ''|*[!0-9]*) return 1 ;; esac
		[ "$octet" -le 255 ] || return 1
	done
	case "$first.$second" in
		10.*|127.*|169.254|192.168) return 0 ;;
		172.*) [ "$second" -ge 16 ] && [ "$second" -le 31 ] ;;
		*) return 1 ;;
	esac
}

valid_controller_ipv4() {
	local address="$1"
	local first second third fourth octet
	IFS=. read -r first second third fourth <<EOF
$address
EOF
	for octet in "$first" "$second" "$third" "$fourth"; do
		case "$octet" in ''|*[!0-9]*) return 1 ;; esac
		[ "$octet" -le 255 ] || return 1
	done
	case "$first.$second" in
		10.*|192.168) return 0 ;;
		172.*) [ "$second" -ge 16 ] && [ "$second" -le 31 ] ;;
		*) return 1 ;;
	esac
}

valid_hostname() {
	local hostname="$1"
	[ -n "$hostname" ] && [ "${#hostname}" -le 253 ] || return 1
	case "$hostname" in
		.*|*.|*..*|*[!A-Za-z0-9.-]*) return 1 ;;
	esac
	case "$hostname" in
		[0-9]*.[0-9]*.[0-9]*.[0-9]*) return 1 ;;
	esac
	return 0
}

cidr_valid() {
	awk -v cidr="$1" '
	function valid_ip(ip, parts, count, i) {
		count = split(ip, parts, ".")
		if (count != 4) return 0
		for (i = 1; i <= 4; i++)
			if (parts[i] !~ /^[0-9]+$/ || parts[i] < 0 || parts[i] > 255) return 0
		return 1
	}
	BEGIN {
		count = split(cidr, fields, "/")
		exit(!(count == 2 && valid_ip(fields[1]) && fields[2] ~ /^[0-9]+$/ && fields[2] >= 8 && fields[2] <= 24))
	}'
}

cidr_overlap() {
	awk -v left="$1" -v right="$2" '
	function ipnum(ip, parts) {
		split(ip, parts, ".")
		return (((parts[1] * 256) + parts[2]) * 256 + parts[3]) * 256 + parts[4]
	}
	function bounds(cidr, out, fields, prefix, size, start) {
		split(cidr, fields, "/")
		prefix = fields[2] + 0
		size = 2 ^ (32 - prefix)
		start = int(ipnum(fields[1]) / size) * size
		out[1] = start
		out[2] = start + size - 1
	}
	BEGIN {
		bounds(left, a)
		bounds(right, b)
		exit(!((a[1] <= b[2]) && (b[1] <= a[2])))
	}'
}

required_filter_missing_count() {
	local filters panel panel_enabled required missing=0
	filters="$(value "$PENDING_SECTION" fake_ip_filter)"
	panel="$(value "$PENDING_SECTION" panel_hostname panel.router)"
	panel_enabled="$(value "$PENDING_SECTION" panel_enabled 0)"
	for required in '*.lan' '*.local'; do
		case " $filters " in
			*" $required "*) ;;
			*) missing=$((missing + 1)) ;;
		esac
	done
	if [ "$panel_enabled" = 1 ]; then
		case " $filters " in
			*" $panel "*) ;;
			*) missing=$((missing + 1)) ;;
		esac
	fi
	printf '%s\n' "$missing"
}

preflight() {
	local blockers=0 warnings=0 corrections=0
	local dns_mode dns_listen dns_port proxy_mode tun_stack tproxy_port routing_mark
	local controller_mode controller_host controller_port panel_enabled panel_hostname
	local fake_range fake_filter_mode missing route

	if [ "$(uci -q get "ssclash_profile.$PENDING_SECTION" 2>/dev/null)" != router ]; then
		json_result false pending_missing "No staged Router Integration settings were found." 1 0 0
		return 1
	fi
	if [ "$(value main source_mode manual)" = manual ]; then
		json_result false manual_mode "Router Integration is applied transactionally to managed Subscription or Proxy links configurations; switch away from Manual YAML first." 1 0 0
		return 1
	fi

	dns_mode="$(value "$PENDING_SECTION" dns_mode redir-host)"
	dns_listen="$(value "$PENDING_SECTION" dns_listen 127.0.0.1:7874)"
	dns_port=${dns_listen##*:}
	proxy_mode="$(value "$PENDING_SECTION" proxy_mode tproxy)"
	tun_stack="$(value "$PENDING_SECTION" tun_stack system)"
	tproxy_port="$(value "$PENDING_SECTION" tproxy_port 7894)"
	routing_mark="$(value "$PENDING_SECTION" routing_mark 2)"
	controller_mode="$(value "$PENDING_SECTION" controller_mode auto)"
	controller_host="$(value "$PENDING_SECTION" controller_host)"
	controller_port="$(value "$PENDING_SECTION" controller_port 9090)"
	panel_enabled="$(value "$PENDING_SECTION" panel_enabled 0)"
	panel_hostname="$(value "$PENDING_SECTION" panel_hostname panel.router)"

	case "$dns_mode" in redir-host|fake-ip) ;; *) blockers=$((blockers + 1)) ;; esac
	valid_dns_listener "$dns_listen" || blockers=$((blockers + 1))
	case "$proxy_mode" in tproxy|tun|mixed) ;; *) blockers=$((blockers + 1)) ;; esac
	case "$tun_stack" in system|gvisor|mixed) ;; *) blockers=$((blockers + 1)) ;; esac
	valid_port "$tproxy_port" || blockers=$((blockers + 1))
	valid_port "$controller_port" || blockers=$((blockers + 1))
	case "$routing_mark" in
		''|*[!0-9]*|1|3) blockers=$((blockers + 1)) ;;
		*) [ "$routing_mark" -ge 2 ] && [ "$routing_mark" -le 65535 ] || blockers=$((blockers + 1)) ;;
	esac
	if [ "$controller_port" = "$dns_port" ] ||
		{ [ "$proxy_mode" != tun ] &&
			{ [ "$tproxy_port" = "$controller_port" ] || [ "$tproxy_port" = "$dns_port" ]; }; }; then
		blockers=$((blockers + 1))
	fi
	case "$controller_mode" in
		auto) ;;
		custom) valid_controller_ipv4 "$controller_host" || blockers=$((blockers + 1)) ;;
		*) blockers=$((blockers + 1)) ;;
	esac
	case "$panel_enabled" in
		0|1) ;;
		*) blockers=$((blockers + 1)) ;;
	esac
	valid_hostname "$panel_hostname" || blockers=$((blockers + 1))

	if [ "$(value "$PENDING_SECTION" ipv6_enabled 0)" = 1 ]; then
		blockers=$((blockers + 1))
	fi
	if [ "$proxy_mode" = tun ] || [ "$proxy_mode" = mixed ]; then
		[ -c /dev/net/tun ] || blockers=$((blockers + 1))
	fi

	if [ "$dns_mode" = fake-ip ]; then
		fake_range="$(value "$PENDING_SECTION" fake_ip_range 198.18.0.1/16)"
		fake_filter_mode="$(value "$PENDING_SECTION" fake_ip_filter_mode blacklist)"
		cidr_valid "$fake_range" || blockers=$((blockers + 1))
		case "$fake_filter_mode" in blacklist|whitelist) ;; *) blockers=$((blockers + 1)) ;; esac
		missing="$(required_filter_missing_count)"
		if [ "$missing" -gt 0 ]; then
			corrections="$missing"
			blockers=$((blockers + 1))
		fi
		if cidr_valid "$fake_range"; then
			for route in $(ip -4 route show 2>/dev/null | awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ { print $1 }'); do
				if cidr_overlap "$fake_range" "$route"; then
					blockers=$((blockers + 1))
					break
				fi
			done
		fi
		[ "$(value "$PENDING_SECTION" store_fake_ip 1)" = 1 ] || warnings=$((warnings + 1))
	fi

	if [ "$blockers" -gt 0 ]; then
		json_result false incompatible "Compatibility checks found settings that must be corrected before activation." "$blockers" "$warnings" "$corrections"
		return 1
	fi
	json_result true compatible "Router Integration settings passed compatibility checks." 0 "$warnings" 0
}

add_filter_if_missing() {
	local filter="$1"
	local filters
	filters="$(value "$PENDING_SECTION" fake_ip_filter)"
	case " $filters " in
		*" $filter "*) ;;
		*) uci -q add_list "ssclash_profile.$PENDING_SECTION.fake_ip_filter=$filter" ;;
	esac
}

apply_safe_corrections() {
	local panel panel_enabled
	[ "$(uci -q get "ssclash_profile.$PENDING_SECTION" 2>/dev/null)" = router ] || return 1
	panel="$(value "$PENDING_SECTION" panel_hostname panel.router)"
	panel_enabled="$(value "$PENDING_SECTION" panel_enabled 0)"
	add_filter_if_missing '*.lan' || return 1
	add_filter_if_missing '*.local' || return 1
	if [ "$panel_enabled" = 1 ]; then
		add_filter_if_missing "$panel" || return 1
	fi
	uci -q set "ssclash_profile.$PENDING_SECTION.store_fake_ip=1" || return 1
	uci -q commit ssclash_profile || return 1
	chmod 600 "$PROFILE_CONFIG" 2>/dev/null || true
	preflight
}

copy_option() {
	local option="$1"
	local current
	current="$(uci -q get "ssclash_profile.$PENDING_SECTION.$option" 2>/dev/null)"
	if [ -n "$current" ]; then
		uci -q set "ssclash_profile.$ROUTER_SECTION.$option=$current"
	else
		uci -q delete "ssclash_profile.$ROUTER_SECTION.$option" 2>/dev/null || true
	fi
}

generate_secret() {
	local secret
	if [ -r /proc/sys/kernel/random/uuid ]; then
		secret="$(sed -n '1p' /proc/sys/kernel/random/uuid | tr -d '-')$(sed -n '1p' /proc/sys/kernel/random/uuid | tr -d '-')"
	else
		secret="$(od -An -N32 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
	fi
	[ "${#secret}" -ge 32 ] || return 1
	printf '%s\n' "$secret"
}

promote_pending() {
	local option filter secret
	for option in \
		dns_mode dns_listen fake_ip_range fake_ip_filter_mode store_fake_ip \
		proxy_mode tproxy_port routing_mark tun_stack ipv6_enabled \
		controller_mode controller_host controller_port panel_enabled panel_hostname; do
		copy_option "$option" || return 1
	done
	uci -q delete "ssclash_profile.$ROUTER_SECTION.fake_ip_filter" 2>/dev/null || true
	set -f
	for filter in $(value "$PENDING_SECTION" fake_ip_filter); do
		uci -q add_list "ssclash_profile.$ROUTER_SECTION.fake_ip_filter=$filter" || {
			set +f
			return 1
		}
	done
	set +f
	if [ "$(value "$PENDING_SECTION" rotate_controller_secret 0)" = 1 ]; then
		secret="$(generate_secret)" || return 1
		printf "set ssclash_profile.%s.controller_secret='%s'\n" \
			"$ROUTER_SECTION" "$secret" | uci -q batch || return 1
	fi
	uci -q commit ssclash_profile || return 1
	chmod 600 "$PROFILE_CONFIG" 2>/dev/null || true
}

apply_pending() {
	local backup result status
	preflight >/dev/null || {
		preflight
		return 1
	}
	backup="$(mktemp /tmp/ssclash-router-integration.XXXXXX)" || return 1
	chmod 600 "$backup"
	cp -p "$PROFILE_CONFIG" "$backup" || {
		rm -f "$backup"
		return 1
	}
	if ! promote_pending; then
		cp -p "$backup" "$PROFILE_CONFIG" 2>/dev/null || true
		rm -f "$backup"
		json_result false uci_commit_failed "Router Integration settings could not be committed." 1 0 0
		return 1
	fi
	if ! "$PANEL_HELPER" apply >/dev/null 2>&1; then
		cp -p "$backup" "$PROFILE_CONFIG" 2>/dev/null || true
		uci -q commit ssclash_profile 2>/dev/null || true
		"$PANEL_HELPER" apply >/dev/null 2>&1 || true
		rm -f "$backup"
		json_result false panel_apply_failed "The optional panel DNS alias could not be applied; the previous router settings were restored." 1 0 0
		return 1
	fi

	result="$("$PROFILE_SYNC" sync 2>/dev/null)"
	status=$?
	if [ "$status" -ne 0 ]; then
		cp -p "$backup" "$PROFILE_CONFIG" 2>/dev/null || true
		uci -q commit ssclash_profile 2>/dev/null || true
		"$PANEL_HELPER" apply >/dev/null 2>&1 || true
		rm -f "$backup"
		printf '%s\n' "$result"
		return "$status"
	fi

	uci -q delete "ssclash_profile.$PENDING_SECTION" 2>/dev/null || true
	uci -q commit ssclash_profile || true
	chmod 600 "$PROFILE_CONFIG" 2>/dev/null || true
	rm -f "$backup"
	printf '%s\n' "$result"
}

case "${1:-preflight}" in
	preflight) preflight ;;
	correct) apply_safe_corrections ;;
	apply) apply_pending ;;
	*)
		echo "Usage: $0 {preflight|correct|apply}" >&2
		exit 2
		;;
esac
