#!/bin/sh

set -u
LC_ALL=C
export LC_ALL

STATE_DIR=${SSCLASH_PANEL_STATE_DIR:-/etc/ssclash-party}
STATE_FILE=$STATE_DIR/panel.state
HOST_CONFIG=${SSCLASH_PANEL_HOST_CONFIG:-/www/ssclash-party-host.js}
DNSMASQ_INIT=${SSCLASH_DNSMASQ_INIT:-/etc/init.d/dnsmasq}
UHTTPD_INIT=${SSCLASH_UHTTPD_INIT:-/etc/init.d/uhttpd}
RESTART_DELAY=${SSCLASH_PANEL_RESTART_DELAY:-1}
INDEX_NAME=ssclash-party-index.html
LEGACY_UI_ALIAS=/party-dashboard=/opt/clash/ui

router_value() {
	local option="$1"
	local fallback="${2:-}"
	local result
	result="$(uci -q get "ssclash_profile.router.$option" 2>/dev/null)"
	[ -n "$result" ] && printf '%s\n' "$result" || printf '%s\n' "$fallback"
}

resolve_lan_interface() {
	local interface
	interface="$(uci -q get ssclash_profile.main.lan_interface)"
	[ -n "$interface" ] || interface=lan
	case "$interface" in
		''|*[!A-Za-z0-9_.:-]*) return 1 ;;
	esac
	printf '%s\n' "$interface"
}

resolve_lan_device() {
	local interface device
	interface="$(resolve_lan_interface)" || return 1
	device="$(ubus -S call "network.interface.$interface" status 2>/dev/null |
		jsonfilter -e '@.l3_device' 2>/dev/null)"
	[ -n "$device" ] || device="$(uci -q get "network.$interface.device")"
	[ -n "$device" ] || device="br-$interface"
	case "$device" in
		''|*[!A-Za-z0-9_.:-]*) return 1 ;;
	esac
	printf '%s\n' "$device"
}

resolve_lan_dhcp_section() {
	local interface="$1"
	local configured key line section
	while IFS= read -r line; do
		case "$line" in
			dhcp.*=dhcp)
				key="${line%%=*}"
				section="${key#dhcp.}"
				configured="$(uci -q get "dhcp.$section.interface")"
				if [ "$configured" = "$interface" ]; then
					printf '%s\n' "$section"
					return 0
				fi
				;;
		esac
	done <<-EOF
	$(uci -q show dhcp 2>/dev/null)
	EOF
	return 1
}

state_value() {
	local key="$1"
	[ -r "$STATE_FILE" ] || return 0
	sed -n "s/^$key=//p" "$STATE_FILE" | sed -n '1p'
}

remove_dns_record() {
	local hostname="$1"
	local dhcp_section="$2"
	local device="$3"
	[ -n "$hostname" ] || return 0
	if [ -n "$dhcp_section" ]; then
		uci -q del_list "dhcp.$dhcp_section.interface_name=$hostname" 2>/dev/null || true
	fi
	# PARTY.4 stored this option on the global dnsmasq section. OpenWrt only
	# consumes interface_name from a DHCP interface section, so remove that
	# inert legacy value while upgrading.
	if [ -n "$device" ]; then
		uci -q del_list "dhcp.@dnsmasq[0].interface_name=$hostname,$device" 2>/dev/null || true
	fi
}

remove_word() {
	local words="$1"
	local unwanted="$2"
	local word result=
	for word in $words; do
		[ "$word" = "$unwanted" ] && continue
		result="${result:+$result }$word"
	done
	printf '%s\n' "$result"
}

configure_index() {
	local enabled="$1"
	local indexes index
	indexes="$(uci -q get uhttpd.main.index_page)"
	indexes="$(remove_word "$indexes" "$INDEX_NAME")"
	if [ "$enabled" = 1 ]; then
		indexes="$INDEX_NAME${indexes:+ $indexes}"
	fi
	uci -q delete uhttpd.main.index_page 2>/dev/null || true
	for index in $indexes; do
		uci -q add_list "uhttpd.main.index_page=$index" || return 1
	done
}

remove_legacy_alias() {
	# PARTY.4 used uHTTPd's URL rewrite option as a filesystem alias. It
	# prepended the target to the original URL and therefore always returned
	# 404. The package now owns /www/party-dashboard as a static symlink.
	uci -q del_list "uhttpd.main.alias=$LEGACY_UI_ALIAS" 2>/dev/null || true
}

write_state() {
	local enabled="$1"
	local hostname="$2"
	local interface="$3"
	local dhcp_section="$4"
	local device="$5"
	mkdir -p "$STATE_DIR" || return 1
	chmod 700 "$STATE_DIR" 2>/dev/null || true
	umask 077
	{
		printf 'enabled=%s\n' "$enabled"
		printf 'hostname=%s\n' "$hostname"
		printf 'interface=%s\n' "$interface"
		printf 'dhcp_section=%s\n' "$dhcp_section"
		printf 'device=%s\n' "$device"
	} > "$STATE_FILE.tmp" || return 1
	mv "$STATE_FILE.tmp" "$STATE_FILE"
}

restart_services() {
	"$DNSMASQ_INIT" restart >/dev/null 2>&1 || return 1
	(
		sleep "$RESTART_DELAY"
		"$UHTTPD_INIT" restart >/dev/null 2>&1
	) >/dev/null 2>&1 &
}

apply_panel() {
	local enabled hostname interface dhcp_section device
	local old_hostname old_dhcp_section old_device
	enabled="$(router_value panel_enabled 0)"
	hostname="$(router_value panel_hostname panel.router)"
	case "$hostname" in
		''|.*|*.|*..*|*[!A-Za-z0-9.-]*)
			printf '%s\n' '{"ok":false,"code":"invalid_hostname"}'
			return 1
			;;
	esac
	interface="$(resolve_lan_interface)" || interface="$(state_value interface)"
	device="$(resolve_lan_device)" || device="$(state_value device)"
	dhcp_section="$(resolve_lan_dhcp_section "$interface")" ||
		dhcp_section="$(state_value dhcp_section)"
	if [ "$enabled" = 1 ]; then
		[ -n "$interface" ] || {
			printf '%s\n' '{"ok":false,"code":"lan_interface_unavailable"}'
			return 1
		}
		[ -n "$device" ] || {
			printf '%s\n' '{"ok":false,"code":"lan_device_unavailable"}'
			return 1
		}
		[ -n "$dhcp_section" ] || {
			printf '%s\n' '{"ok":false,"code":"lan_dhcp_section_unavailable"}'
			return 1
		}
	fi
	old_hostname="$(state_value hostname)"
	old_dhcp_section="$(state_value dhcp_section)"
	old_device="$(state_value device)"

	remove_dns_record "$old_hostname" "$old_dhcp_section" "$old_device"
	remove_dns_record "$old_hostname" "$dhcp_section" "$old_device"
	remove_dns_record "$hostname" "$dhcp_section" "$device"
	case "$enabled" in
		1)
			uci -q add_list "dhcp.$dhcp_section.interface_name=$hostname" || return 1
			configure_index 1 || return 1
			;;
		*)
			enabled=0
			configure_index 0 || return 1
			;;
	esac
	remove_legacy_alias
	uci -q commit dhcp || return 1
	uci -q commit uhttpd || return 1
	printf 'window.SSCLASH_PARTY_PANEL_HOST = "%s";\n' "$hostname" > "$HOST_CONFIG.tmp" || return 1
	chmod 644 "$HOST_CONFIG.tmp" || return 1
	mv "$HOST_CONFIG.tmp" "$HOST_CONFIG" || return 1
	write_state "$enabled" "$hostname" "$interface" "$dhcp_section" "$device" || return 1
	restart_services || return 1
	printf '{"ok":true,"enabled":%s,"hostname":"%s"}\n' "$enabled" "$hostname"
}

remove_panel() {
	local hostname dhcp_section device
	hostname="$(state_value hostname)"
	dhcp_section="$(state_value dhcp_section)"
	device="$(state_value device)"
	remove_dns_record "$hostname" "$dhcp_section" "$device"
	configure_index 0
	remove_legacy_alias
	uci -q commit dhcp 2>/dev/null || true
	uci -q commit uhttpd 2>/dev/null || true
	rm -f "$STATE_FILE"
	printf '%s\n' 'window.SSCLASH_PARTY_PANEL_HOST = "panel.router";' > "$HOST_CONFIG" 2>/dev/null || true
	restart_services || true
}

panel_status() {
	local enabled hostname
	enabled="$(state_value enabled)"
	hostname="$(state_value hostname)"
	[ "$enabled" = 1 ] || enabled=0
	printf '{"ok":true,"enabled":%s,"hostname":"%s"}\n' "$enabled" "$hostname"
}

case "${1:-status}" in
	apply) apply_panel ;;
	remove) remove_panel ;;
	status) panel_status ;;
	*)
		echo "Usage: $0 {apply|remove|status}" >&2
		exit 2
		;;
esac
