#!/usr/bin/env bash
set -euo pipefail

command_name="${0##*/}"

state_get() {
    local key="$1"
    awk -F= -v wanted="$key" '
        $1 == wanted {
            sub(/^[^=]*=/, "")
            print
            found = 1
            exit
        }
        END { if (!found) exit 1 }
    ' "${FAKE_UCI_STATE:?}"
}

state_set() {
    local key="$1"
    local value="$2"
    local temporary="${FAKE_UCI_STATE}.tmp.$$"
    awk -F= -v wanted="$key" -v replacement="$value" '
        $1 == wanted {
            print wanted "=" replacement
            found = 1
            next
        }
        { print }
        END { if (!found) print wanted "=" replacement }
    ' "${FAKE_UCI_STATE:?}" > "$temporary"
    mv "$temporary" "$FAKE_UCI_STATE"
}

state_delete() {
    local key="$1"
    local temporary="${FAKE_UCI_STATE}.tmp.$$"
    awk -F= -v wanted="$key" '
        $1 != wanted && index($1, wanted ".") != 1 { print }
    ' "${FAKE_UCI_STATE:?}" > "$temporary"
    mv "$temporary" "$FAKE_UCI_STATE"
}

state_add_list() {
    local key="$1"
    local value="$2"
    local current=
    current="$(state_get "$key" 2>/dev/null || true)"
    state_set "$key" "${current:+$current }$value"
}

state_del_list() {
    local key="$1"
    local unwanted="$2"
    local current word result=
    current="$(state_get "$key" 2>/dev/null || true)"
    for word in $current; do
        [[ "$word" == "$unwanted" ]] && continue
        result="${result:+$result }$word"
    done
    if [[ -n "$result" ]]; then state_set "$key" "$result"; else state_delete "$key"; fi
}

parse_uci_assignment() {
    local assignment="$1"
    UCI_KEY="${assignment%%=*}"
    UCI_VALUE="${assignment#*=}"
    if [[ "$UCI_VALUE" == \'*\' ]]; then
        UCI_VALUE="${UCI_VALUE#\'}"
        UCI_VALUE="${UCI_VALUE%\'}"
        UCI_VALUE="${UCI_VALUE//\'\\\'\'/\'}"
    fi
}

run_uci_line() {
    local line="$1"
    local operation assignment
    operation="${line%% *}"
    assignment="${line#* }"
    case "$operation" in
    set)
        parse_uci_assignment "$assignment"
        state_set "$UCI_KEY" "$UCI_VALUE"
        ;;
    add_list)
        parse_uci_assignment "$assignment"
        state_add_list "$UCI_KEY" "$UCI_VALUE"
        ;;
    del_list)
        parse_uci_assignment "$assignment"
        state_del_list "$UCI_KEY" "$UCI_VALUE"
        ;;
    delete)
        state_delete "$assignment"
        ;;
    '') ;;
    *) return 2 ;;
    esac
}

case "$command_name" in
uci)
    while [[ "${1:-}" == -* ]]; do shift; done
    operation="${1:-}"
    shift || true
    case "$operation" in
    get)
        state_get "${1:?}"
        ;;
    set)
        assignment="${1:?}"
        run_uci_line "set $assignment"
        ;;
    add_list|del_list)
        assignment="${1:?}"
        run_uci_line "$operation $assignment"
        ;;
    delete)
        state_delete "${1:?}"
        ;;
    show)
        if [[ -n "${1:-}" ]]; then
            awk -v prefix="${1}." 'index($0, prefix) == 1 { print }' "${FAKE_UCI_STATE:?}"
        else
            cat "${FAKE_UCI_STATE:?}"
        fi
        ;;
    batch)
        while IFS= read -r line; do run_uci_line "$line"; done
        ;;
    commit)
        ;;
    *)
        exit 2
        ;;
    esac
    ;;

jsonfilter)
    input_file=
    expression=
    while (($#)); do
        case "$1" in
        -i)
            input_file="$2"
            shift 2
            ;;
        -e)
            expression="$2"
            shift 2
            ;;
        *)
            shift
            ;;
        esac
    done
    case "$expression" in
    '@["ipv4-address"][0].address')
        if [[ -n "$input_file" ]]; then
            jq -r '.["ipv4-address"][0].address // empty' "$input_file"
        else
            jq -r '.["ipv4-address"][0].address // empty'
        fi
        ;;
    @.*)
        jq -r ".${expression#@.} // empty" "$input_file"
        ;;
    *)
        exit 2
        ;;
    esac
    ;;

ubus)
    [[ "${1:-}" == -S ]]
    shift
    [[ "${1:-}" == call && "${2:-}" == network.interface.* && "${3:-}" == status ]]
    printf '{"ipv4-address":[{"address":"%s"}]}\n' "${FAKE_LAN_ADDRESS:-192.168.10.1}"
    ;;

curl)
    output_file=
    response_headers=
    request_headers=
    request_url=
    while (($#)); do
        case "$1" in
        -o)
            output_file="$2"
            shift 2
            ;;
        -D)
            response_headers="$2"
            shift 2
            ;;
        -H)
            if [[ "$2" == @* ]]; then request_headers="${2#@}"; fi
            shift 2
            ;;
        http://*|https://*)
            request_url="$1"
            shift
            ;;
        *)
            shift
            ;;
        esac
    done
    [[ -n "$output_file" && -n "$request_headers" ]]
    if [[ -n "${FAKE_CONTROLLER_HANG_SECONDS:-}" && "$request_url" == */version ]]; then
        exec sleep "$FAKE_CONTROLLER_HANG_SECONDS"
    fi

    if [[ -z "$response_headers" ]]; then
        if [[ -n "${FAKE_CONTROLLER_FAIL_ONCE_FILE:-}" &&
              ! -e "$FAKE_CONTROLLER_FAIL_ONCE_FILE" ]]; then
            : > "$FAKE_CONTROLLER_FAIL_ONCE_FILE"
            exit 97
        fi
        printf '%s\n' '{}' > "$output_file"
        printf '200'
        exit 0
    fi

    count=0
    if [[ -s "${FAKE_CURL_COUNT:?}" ]]; then read -r count < "$FAKE_CURL_COUNT"; fi
    count=$((count + 1))
    printf '%s\n' "$count" > "$FAKE_CURL_COUNT"

    user_agent="$(awk -F': ' 'tolower($1) == "user-agent" { print $2; exit }' "$request_headers")"
    has_hwid=false
    grep -qi '^x-hwid:' "$request_headers" && has_hwid=true

    printf 'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n' > "$response_headers"
    case "${FAKE_CURL_SCENARIO:?}" in
    adaptive-links)
        if [[ "$count" -eq 1 && "$user_agent" == mihomo/* && "$has_hwid" == false ]]; then
            printf '<!doctype html><title>client landing page</title>\n' > "$output_file"
        elif [[ "$count" -eq 2 && "$user_agent" == SSClash-PARTY/* && "$has_hwid" == false ]]; then
            base64 "${FAKE_FIXTURE_DIR:?}/links.txt" > "$output_file"
        else
            exit 90
        fi
        ;;
    hwid-full)
        if [[ "$count" -le 2 && "$has_hwid" == false ]]; then
            printf 'x-hwid-not-supported: true\r\n' >> "$response_headers"
            printf 'HWID is required\n' > "$output_file"
        elif [[ "$count" -eq 3 && "$user_agent" == mihomo/* && "$has_hwid" == true ]]; then
            cp "${FAKE_FIXTURE_DIR:?}/full.yaml" "$output_file"
        else
            exit 91
        fi
        ;;
    hwid-limit)
        [[ "$count" -eq 1 && "$has_hwid" == false ]] || exit 94
        printf 'x-hwid-limit: true\r\n' >> "$response_headers"
        printf 'Device limit reached\n' > "$output_file"
        ;;
    source-changed)
        [[ "$count" -eq 1 && "$has_hwid" == false ]] || exit 95
        state_set ssclash_profile.main.source_mode manual
        cp "${FAKE_FIXTURE_DIR:?}/full.yaml" "$output_file"
        ;;
    invalid)
        [[ "$has_hwid" == false ]] || exit 92
        printf '<!doctype html><title>unsupported response</title>\n' > "$output_file"
        ;;
    full)
        [[ "$count" -eq 1 && "$has_hwid" == false ]] || exit 96
        cp "${FAKE_FIXTURE_DIR:?}/full.yaml" "$output_file"
        ;;
    *)
        exit 93
        ;;
    esac
    printf '\r\n' >> "$response_headers"
    printf '200'
    ;;

clash)
    if [[ "${1:-}" == -v ]]; then
        printf 'Mihomo Meta v1.19.29 linux amd64\n'
        exit 0
    fi
    config_file=
    while (($#)); do
        if [[ "$1" == -f ]]; then
            config_file="$2"
            shift 2
        else
            shift
        fi
    done
    [[ -s "$config_file" ]]
    grep -q '^proxy-groups:' "$config_file"
    grep -q '^rules:' "$config_file"
    ;;

clash-init)
    case "${1:-}" in
    status)
        grep -qx 'running=1' "${FAKE_SERVICE_STATE:?}"
        ;;
    start)
        if [[ -n "${FAKE_CLASH_START_DELAY_SECONDS:-}" ]]; then
            sleep "$FAKE_CLASH_START_DELAY_SECONDS"
        fi
        sed -i 's/^running=.*/running=1/' "$FAKE_SERVICE_STATE"
        ;;
    stop)
        sed -i 's/^running=.*/running=0/' "$FAKE_SERVICE_STATE"
        ;;
    enable)
        sed -i 's/^enabled=.*/enabled=1/' "$FAKE_SERVICE_STATE"
        ;;
    disable)
        sed -i 's/^enabled=.*/enabled=0/' "$FAKE_SERVICE_STATE"
        ;;
    *)
        exit 2
        ;;
    esac
    ;;

logger)
    if [[ -n "${FAKE_LOG_FILE:-}" ]]; then
        printf '%s\n' "$*" >> "$FAKE_LOG_FILE"
    fi
    ;;

nslookup)
    if [[ -n "${FAKE_NSLOOKUP_PID_FILE:-}" ]]; then
        printf '%s\n' "$$" >> "$FAKE_NSLOOKUP_PID_FILE"
    fi
    case "${FAKE_NSLOOKUP_MODE:-pass}" in
    pass)
        printf 'Name: %s\nAddress: 192.0.2.1\n' "${1:-example.invalid}"
        ;;
    fail)
        exit 1
        ;;
    hang)
        exec sleep "${FAKE_NSLOOKUP_HANG_SECONDS:-30}"
        ;;
    *)
        exit 2
        ;;
    esac
    ;;

clash-rules)
    ;;

*)
    printf 'Unknown fake command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
